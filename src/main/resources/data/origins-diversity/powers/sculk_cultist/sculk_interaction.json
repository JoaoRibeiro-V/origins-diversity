{
  "name": "Sculk Enhancing",
  "description": "Upon toggle, you let the sculk dive deeper to your body, making you able to:\n- Turn convertible blocks into Sculk by right clicking on them and spending the sculk contained within you.\n- Phase through Sculk blocks\n- Inflict darkness on those who you hit",
  "type": "origins:multiple",
  "formtoggle": {
    "type": "origins:toggle",
    "active_by_default": false,
    "key": {"key": "key.origins.secondary_active"}
  },
  "entitycolor": {
    "type": "origins:model_color",
    "red": 0.831,
    "green": 0.72,
    "blue": 0.922,
    "condition": {
      "type": "origins:power_active",
      "power": "origins-diversity:sculk_cultist/sculk_interaction_formtoggle"
    }
  },
  "onhit": {
    "type": "origins:action_on_hit",
    "damage_condition": {
      "type": "origins:projectile",
      "inverted": true
    },
    "bientity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:target_action",
          "action": {
            "type": "origins:and",
            "actions": [
              {
                "type": "origins:apply_effect",
                "effect": {
                  "id": "minecraft:darkness",
                  "duration": 80
                }
              },
              {
                "type": "origins:change_resource",
                "resource": "origins-diversity:sculk_cultist/sculk_gather",
                "change": -5,
                "operation": "add"
              }
            ]
          }
        }
      ]
    },
    "bientity_condition": {
      "type": "origins:actor_condition",
      "condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:power_active",
            "power": "origins-diversity:sculk_cultist/sculk_interaction_formtoggle"
          },
          {
            "type": "origins:resource",
            "resource": "origins-diversity:sculk_cultist/sculk_gather",
            "comparison": ">=",
            "compare_to": 5
          }
        ]
      }
    }

  },
  "convert": {
    "type": "origins:action_on_block_use",
    "block_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:set_block",
          "block": "origins-diversity:purple_sculk_block"
        }
      ]

    },
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {"type": "origins:swing_hand"},
        {"type": "origins:execute_command", "command": "tag @s add sculk_just_converted"},
        {
          "type": "origins:change_resource",
          "resource": "origins-diversity:sculk_cultist/sculk_gather",
          "change": -5,
          "operation": "add"
        }
      ]
    },
    "block_condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:in_tag",
          "tag": "origins-diversity:sculk_convert"
        },
        {
          "type": "origins:in_tag",
          "tag": "origins-diversity:sculk_immune",
          "inverted": true
        }
      ]
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "origins-diversity:sculk_cultist/sculk_interaction_formtoggle"
        },
        {
          "type": "origins:resource",
          "resource": "origins-diversity:sculk_cultist/sculk_gather",
          "comparison": ">=",
          "compare_to": 5
        }
      ]

    }
  },
  "phasesculk": {
    "type": "origins:phasing",
    "view_distance": 16.0,
    "condition": {
      "type": "origins:power_active",
      "power": "origins-diversity:sculk_cultist/sculk_interaction_formtoggle"
    },
    "block_condition": {
      "type": "origins:or",
      "conditions": [
        {
          "type": "origins:block",
          "block": "minecraft:sculk"
        },
        {
          "type": "origins:block",
          "block": "origins-diversity:purple_sculk_block"
        }
      ]
    }
  }
}