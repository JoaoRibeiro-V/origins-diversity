{
  "name": "Sculk Summoning",
  "description": "You can gather your sculk to summon zombies that attack those in sight.\n\nAlternatively, upon gathering an immense amount of sculk and sneaking, perform a sculk ritual, unleashing an untamed beast seeking destruction.",
  "type": "origins:active_self",
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:resource",
      "resource": "origins-diversity:sculk_cultist/summon_cooldown",
      "comparison": "<=",
      "compare_to": 0
    },
    "if_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:if_else",
          "condition": {
            "type": "origins:sneaking"
          },
          "if_action": {
            "type": "origins:if_else",
            "condition": {
              "type": "origins:resource",
              "resource": "origins-diversity:sculk_cultist/sculk_gather",
              "comparison": ">=",
              "compare_to": 599
            },
            "if_action": {
              "type": "origins:and",
              "actions": [
                {
                  "type": "origins:execute_command",
                  "command": "tag @s add sculk_cultist_ritual_pending"
                },
                {
                  "type": "origins:change_resource",
                  "resource": "origins-diversity:sculk_cultist/sculk_gather",
                  "change": 0,
                  "operation": "set"
                },
                {
                  "type": "origins:trigger_cooldown",
                  "power": "origins-diversity:sculk_cultist/summon_cooldown"
                }
              ]
            }
          },
          "else_action": {
            "type": "origins:if_else",
            "condition": {
              "type": "origins:resource",
              "resource": "origins-diversity:sculk_cultist/sculk_gather",
              "comparison": ">=",
              "compare_to": 49
            },
            "if_action": {
              "type": "origins:and",
              "actions": [
                {
                  "type": "origins:execute_command",
                  "command": "tag @s add sculk_zombie_summon"
                },
                {
                  "type": "origins:change_resource",
                  "resource": "origins-diversity:sculk_cultist/sculk_gather",
                  "change": -50,
                  "operation": "add"
                },
                {
                  "type": "origins:change_resource",
                  "resource": "origins-diversity:sculk_cultist/summon_cooldown",
                  "change": 200,
                  "operation": "set"
                }
              ]
            }
          }
        }

      ]

    },
    "else_action": {
      "type": "origins:execute_command",
      "command": "title @s actionbar {\"text\":\"On cooldown...\",\"color\":\"red\"}"
    }
  },
  "cooldown": 1,
  "hud_render": {
    "should_render": false
  }
}