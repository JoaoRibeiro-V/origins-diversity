{
  "name": "Sculk Summoning",
  "description": "With this treasure...\nGather all your sculk to unleash a powerful beast.",
  "type": "origins:active_self",
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:resource",
      "resource": "origins-diversity:sculk_cultist/sculk_gather",
      "comparison": ">=",
      "compare_to": 199
    },
    "if_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "command": "tag @s add sculk_cultist_ritual_pending"
        }
      ]

    },
    "else_action": {
      "type": "origins:execute_command",
      "command": "title @s actionbar {\"text\":\"Not enough Sculk...\",\"color\":\"dark_aqua\"}"
    }
  },
  "cooldown": 1,
  "hud_render": {
    "should_render": false
  }
}