{
  "name": "Night Watcher",
  "description": "§rYou watch from the dark.\n§rAt §9night§r you gain §bNight Vision§r, armor penetration and increased attack speed\n\nStriking enemies from above deals §abonus§r damage and §cslows§r them down.",
  "type": "origins:action_over_time",
  "interval": 20,
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:time_of_day",
          "comparison": ">=",
          "compare_to": 13000
        },
        {
          "type": "origins:time_of_day",
          "comparison": "<=",
          "compare_to": 23000
        }
      ]
    },
    "if_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:power",
            "power": "origins-diversity:owl/night_watcher_active",
            "inverted": true
          }
        ]
      },
      "if_action": {
        "type": "origins:grant_power",
        "power": "origins-diversity:owl/night_watcher_active",
        "source": "origins-diversity"
      }
    },
    "else_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:power",
        "power": "origins-diversity:owl/night_watcher_active"
      },
      "if_action": {
        "type": "origins:and",
        "actions": [
          {
  "type": "origins:execute_command",
  "command": "power remove @s origins-diversity:owl/night_watcher_active"
}
        ]
      }
    }
  }
}