{
  "hidden": true,
  "type": "origins:action_over_time",
  "interval": 1,
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:resource",
      "resource": "origins-diversity:hellhound/scent_bar",
      "comparison": ">",
      "compare_to": 0
    },
    "if_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:power",
        "power": "origins-diversity:hellhound/scent",
        "inverted": true
      },
      "if_action": {
        "type": "origins:grant_power",
        "power": "origins-diversity:hellhound/scent",
        "source": "origins-diversity"
      },
      "else_action": {
        "type": "origins:change_resource",
        "resource": "origins-diversity:hellhound/scent_bar",
        "change": -1
      }
    },
    "else_action": {
  "type": "origins:execute_command",
  "command": "power remove @s origins-diversity:hellhound/scent"
}
  }
}