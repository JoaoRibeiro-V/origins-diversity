{
  "name": "Night Vision",
  "description": "You can see clearly in the dark.",
  "type": "apoli:action_over_time",
  "interval": 20,
  "entity_action": {
    "type": "origins:apply_effect",
    "effect": {
      "id": "minecraft:night_vision",
      "duration": 600,
      "amplifier": 0,
        "show_particles": false
    }
  },
  "condition": {
    "type": "origins:and",
    "conditions": [
      {
        "type": "origins:time_of_day",
        "comparison": ">=",
        "compare_to": 14000
      },
      {
        "type": "origins:time_of_day",
        "comparison": "<=",
        "compare_to": 23000
      }
    ]
  }
}
