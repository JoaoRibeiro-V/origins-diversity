{
  "hidden": true,
  "type": "origins:action_over_time",
  "interval": 10,
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:or",
      "conditions": [
        { "type": "origins:in_rain" },
        { "type": "origins:submerged_in", "fluid": "minecraft:water" }
      ]
    },
    "if_action": {
      "type": "origins:grant_power",
      "power": "origins-diversity:bee/grounded",
      "source": "origins-diversity"
    },
    "else_action": {
  "type": "origins:execute_command",
  "command": "power remove @s origins-diversity:bee/grounded"
}
  }
}
