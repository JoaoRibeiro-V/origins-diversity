{
  "hidden": true,
  "type": "origins:action_over_time",
  "interval": 1,
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:resource",
      "resource": "origins-diversity:phoenix/rebirth_active",
      "comparison": ">",
      "compare_to": 0
    },
    "if_action": {
      "type": "origins:change_resource",
      "resource": "origins-diversity:phoenix/rebirth_active",
      "change": -1
    }
  }
}
