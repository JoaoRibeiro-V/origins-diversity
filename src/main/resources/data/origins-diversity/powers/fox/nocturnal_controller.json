{
  "name": "Nocturnal Predator",
  "description": "§7You thrive in the §9dark§7.\n§7At §9night§7 you gain §bNight Vision§7, §7increased §cattack speed§7, and faster §amovement§7.\n§7These bonuses fade in §edaylight§7.\n",
  "type": "origins:action_over_time",
  "interval": 20,
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:time_of_day",
          "comparison": ">=",
          "compare_to": 14000
        },
        {
          "type": "origins:time_of_day",
          "comparison": "<=",
          "compare_to": 23000
        }
      ]
    },
    "if_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:power",
            "power": "origins-diversity:fox/nocturnal_predator",
            "inverted": true
          }
        ]
      },
      "if_action": {
        "type": "origins:grant_power",
        "power": "origins-diversity:fox/nocturnal_predator",
        "source": "origins-diversity:nocturnal_controller"
      }
    },
    "else_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:power",
        "power": "origins-diversity:fox/nocturnal_predator"
      },
      "if_action": {
        "type": "origins:and",
        "actions": [
          {
            "type": "origins:revoke_power",
            "power": "origins-diversity:fox/nocturnal_predator",
            "source": "origins-diversity:nocturnal_controller"
          }
        ]
      }
    }
  }
}