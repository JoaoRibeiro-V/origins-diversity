{
  "name": "Nocturnal Predator",
  "description": "§rYou thrive in the §9dark§r.\n§rAt §9night§r you gain §bNight Vision§r, §rincreased §cattack speed§r, and faster §amovement§r.\n§rThese bonuses fade in §edaylight§r.",
  "type": "origins:action_over_time",
  "interval": 20,
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:time_of_day",
          "comparison": ">=",
          "compare_to": 13000
        },
        {
          "type": "origins:time_of_day",
          "comparison": "<=",
          "compare_to": 23000
        }
      ]
    },
    "if_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:power",
            "power": "origins-diversity:fox/nocturnal_predator",
            "inverted": true
          }
        ]
      },
      "if_action": {
        "type": "origins:grant_power",
        "power": "origins-diversity:fox/nocturnal_predator",
        "source": "origins-diversity:nocturnal_controller"
      }
    },
    "else_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:power",
        "power": "origins-diversity:fox/nocturnal_predator"
      },
      "if_action": {
        "type": "origins:and",
        "actions": [
          {
            "type": "origins:revoke_power",
            "power": "origins-diversity:fox/nocturnal_predator",
            "source": "origins-diversity:nocturnal_controller"
          }
        ]
      }
    }
  }
}