{
  "name": "Adaptive Camouflage",
  "description": "§rBy crouching for §a2 seconds§r, you trigger your skin's rapid §echromatophore response§r, rendering you partially invisible.\nEmit subtle §bparticles§a to blend with the environment.\n\n§rAttacking normally or getting hit breaks the effect, initiating a §ccooldown§r.",
  "type": "origins:action_over_time",
  "interval": 10,
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:sneaking"
    },
    "if_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:power",
            "power": "origins-diversity:chameleon/camouflaged",
            "inverted": true
          },
          {
            "type": "origins:resource",
            "resource": "origins-diversity:chameleon/camouflage_cooldown",
            "comparison": "==",
            "compare_to": 0
          }
        ]
      },
      "if_action": {
        "type": "origins:grant_power",
        "power": "origins-diversity:chameleon/camouflaged",
        "source": "origins-diversity:chameleon_camouflage"
      }
    },
    "else_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:power",
        "power": "origins-diversity:chameleon/camouflaged"
      },
      "if_action": {
        "type": "origins:and",
        "actions": [
          {
            "type": "origins:revoke_power",
            "power": "origins-diversity:chameleon/camouflaged",
            "source": "origins-diversity:chameleon_camouflage"
          },
          {
            "type": "origins:trigger_cooldown",
            "power": "origins-diversity:chameleon/camouflage_cooldown",
            "duration": 100
          }
        ]
      }
    }
  }
}
