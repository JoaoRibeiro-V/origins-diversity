{
  "hidden": true,
  "type": "origins:action_over_time",
  "interval": 20,
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:sneaking"
    },
    "if_action": {
      "type": "origins:grant_power",
      "power": "origins-diversity:chameleon/camouflaged",
      "source": "origins-diversity"
    },
    "else_action": {
  "type": "origins:execute_command",
  "command": "power remove @s origins-diversity:chameleon/camouflage_sneak_timer"
}
  }
}
