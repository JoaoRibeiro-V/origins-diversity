{

  "name": "Desiccation Sensitivity",
  "description": "§7In dry or hot environments, your body loses moisture rapidly.\n§7You become dried out, §creducing§7 your §ndamage effectiveness§r§7 until you return to a humid biome.",

"type": "origins:action_over_time",
  "interval": 20,
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:biome",
      "condition": {
        "type": "origins:high_humidity",
        "inverted": true
      }
    },
    "if_action": {
      "type": "origins:grant_power",
      "power": "origins-diversity:snail/dried",
      "source": "origins-diversity:snail_dried"
    },
    "else_action": {
        "type": "origins:revoke_power",
        "power": "origins-diversity:snail/dried",
        "source": "origins-diversity:snail_dried"
    }
  }
}
