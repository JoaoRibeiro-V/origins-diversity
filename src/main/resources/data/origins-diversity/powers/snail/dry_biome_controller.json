{

  "name": "Desiccation Sensitivity",
  "description": "§rIn dry or hot environments, your body loses moisture rapidly.\n§rYou become dried out, §creducing§r your §ndamage effectiveness§r§r until you return to a humid biome.",

"type": "origins:action_over_time",
  "interval": 20,
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:biome",
      "condition": {
        "type": "origins:high_humidity",
        "inverted": true
      }
    },
    "if_action": {
      "type": "origins:grant_power",
      "power": "origins-diversity:snail/dried",
      "source": "origins-diversity"
    },
    "else_action": {
  "type": "origins:execute_command",
  "command": "power remove @s origins-diversity:snail/dried"
}
  }
}
