{
  "name": "Gallop",
  "description": "Toggle a state of galloping, which enhances ur running.",
  "type": "origins:active_self",
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:power",
      "power": "origins-diversity:horse/sprinting"
    },
    "if_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:play_sound",
          "sound": "minecraft:entity.horse.breathe",
          "volume": 0.8
        },
        {
  "type": "origins:execute_command",
  "command": "power remove @s origins-diversity:horse/sprinting"
}
      ]
    },
    "else_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:play_sound",
          "sound": "minecraft:entity.horse.gallop",
          "volume": 0.8
        },
        {
          "type": "origins:grant_power",
          "power": "origins-diversity:horse/sprinting",
          "source": "origins-diversity"
        }
      ]

    }
  },
  "cooldown": 20,
  "hud_render": {
    "should_render": false
  },
  "key": {"key": "key.origins.secondary_active"}
}