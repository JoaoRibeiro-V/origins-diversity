{
  "name": "Beached",
  "description": "§rOut of §bwater§r, your body begins to §cfail§r.\nYou grow §csluggish§r and fight §cpoorly§r.\n\nRe-entering §bwater§r or §bhydrating§r yourself stabilizes you.",
  "type": "origins:action_over_time",
  "interval": 20,
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:submerged_in",
          "fluid": "minecraft:water",
          "inverted": true
        },
        {
          "type": "origins:in_rain",
          "inverted": true
        },
        {
          "type": "origins:power_active",
          "power": "origins-diversity:shark/hydrated"
        }
      ]
    },
    "if_action": {
      "type": "origins:grant_power",
      "power": "origins-diversity:shark/beached_active",
      "source": "origins-diversity"
    },
    "else_action": {
  "type": "origins:execute_command",
  "command": "power remove @s origins-diversity:shark/beached_active"
}
  }
}
