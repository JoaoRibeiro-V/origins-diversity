{
  "name": "Beached",
  "description": "§rOut of water, your body begins to fail.\nYou grow sluggish and fight poorly.\n\n§rRe-entering water or §bhydrating§r yourself stabilizes you.",
  "type": "origins:action_over_time",
  "interval": 20,
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:submerged_in",
          "fluid": "minecraft:water",
          "inverted": true
        },
        {
          "type": "origins:in_rain",
          "inverted": true
        },
        {
          "type": "origins:power_active",
          "power": "origins-diversity:shark/hydrated"
        }
      ]
    },
    "if_action": {
      "type": "origins:grant_power",
      "power": "origins-diversity:shark/beached_active",
      "source": "origins-diversity:shark_beached"
    },
    "else_action": {
      "type": "origins:revoke_power",
      "power": "origins-diversity:shark/beached_active",
      "source": "origins-diversity:shark_beached"
    }
  }
}
