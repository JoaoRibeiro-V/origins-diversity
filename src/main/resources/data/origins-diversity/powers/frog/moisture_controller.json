{
  "name": "Moisture",
  "description": "§rYou have a §9moisture§r bar.\nStay in §bwater§r or drink it to fill it.\nWhile moisturized:\n- You deal and take less damage\n- You exhaust less quickly",
  "type": "origins:action_over_time",
  "interval": 30,
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:resource",
      "resource": "origins-diversity:frog/moisture_bar",
      "comparison": ">",
      "compare_to": 0
    },
    "if_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:power",
        "power": "origins-diversity:frog/moisture"
      },
      "if_action": {
        "type": "origins:change_resource",
        "resource": "origins-diversity:frog/moisture_bar",
        "change": -1
      },
      "else_action": {
        "type": "origins:grant_power",
        "power": "origins-diversity:frog/moisture",
        "source": "origins-diversity:moisture_controller"
      }
    },
    "else_action": {
      "type": "origins:revoke_power",
      "power": "origins-diversity:frog/moisture",
      "source": "origins-diversity:moisture_controller"
    }
  }
}