{
  "name": "Cold Regeneration",
  "description": "§rCold environments stabilize your core.\n\nWhile in §bcold biomes§r or standing on §bsnow§r, you slowly regenerate hunger.",
  "type": "origins:action_over_time",
  "interval": 60,
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:or",
      "conditions": [
        {
          "type": "origins:biome",
          "condition": {
            "type": "origins:temperature",
            "comparison": "<=",
            "compare_to": 0.15
          }
        },
        {
          "type": "origins:block_in_radius",
          "block_condition": {
            "type": "origins:or",
            "conditions": [
              { "type": "origins:block", "block": "minecraft:snow" },
              { "type": "origins:block", "block": "minecraft:snow_block" }
            ]
          },
          "radius": 1
        }
      ]
    },
    "if_action": {
      "type": "origins:feed",
      "food": 2,
      "saturation": 2,
      "nutrition": 2
    }
  }
}
