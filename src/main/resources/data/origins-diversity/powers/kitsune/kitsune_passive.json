{
  "hidden": false,
  "name": "Fox Spirits",
  "description": "§rUpon activation you can shapeshift into a fox, getting hit will disable this.\n\n§rAdditionally, if used while crouching, you can make §dspirit tails§r out of §e25§r experience levels§r. §cLose§r one of your wisps upon death.",
  "type": "origins:multiple",
  "loseondeath": {
    "type": "origins:action_on_callback",
    "entity_action_respawned": {
        "type": "origins:change_resource",
        "change": -1,
        "operation": "add",
        "resource": "origins-diversity:kitsune/kitsune_tails"
    }
  },
  "active": {
    "hidden": false,
    "name": "Spirit Manipulation",
    "description": "You can shapeshift into a fox.\nAdditionally, you can make spirit tails out of 25 experience levels if you sneak.",
    "type": "origins:active_self",
    "entity_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:sneaking"
      },
      "if_action": {
        "type": "origins:if_else",
        "condition": {
          "type": "origins:xp_levels",
          "comparison": ">=",
          "compare_to": 25
        },
        "if_action": {
          "type": "origins:and",
          "actions": [
            {
              "type": "origins:add_xp",
              "levels": -25
            },
            {
              "type": "origins:change_resource",
              "change": 1,
              "operation": "add",
              "resource": "origins-diversity:kitsune/kitsune_tails"
            }
          ]
        }
      },
      "else_action": {
        "type": "origins:if_else",
        "condition": {
          "type": "origins:power",
          "power": "origins-diversity:kitsune/kitsune_fox_form"
        },
        "if_action": {
  "type": "origins:execute_command",
  "command": "power remove @s origins-diversity:kitsune/kitsune_fox_form"
},
        "else_action": {
          "type": "origins:grant_power",
          "power": "origins-diversity:kitsune/kitsune_fox_form",
          "source": "origins-diversity"
        }
      }
    },
    "cooldown": 40
  }
}
